@import 'tailwindcss';

:root {
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #0a0a0a;
  background: #fff;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
html, body, #root { min-height: 100%; margin: 0; background: #fff; }
button, input { font: inherit; }
button { -webkit-tap-highlight-color: transparent; }

.page { min-height: 100vh; background: #fff; padding: 18px 16px 28px; }
.shell { width: min(720px, 100%); margin: 0 auto; }

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 14px;
}

h1 {
  margin: 0;
  font-size: 16px;
  line-height: 1;
  letter-spacing: .09em;
  font-weight: 650;
}

.section {
  border-top: 1px solid #e7e7e7;
  padding: 14px 0;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 9px;
  font-size: 13px;
  line-height: 1.2;
  font-weight: 650;
}

.muted { color: #8c8c8c; font-weight: 400; }

input {
  width: 100%;
  height: 40px;
  border: 1px solid #dedede;
  border-radius: 9px;
  background: #fff;
  color: #0a0a0a;
  padding: 0 11px;
  outline: none;
  font-size: 16px;
}

input:focus { border-color: #0a0a0a; }
input::placeholder { color: #a7a7a7; }

.add-row,
.field-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
}

.text-button {
  height: 40px;
  border: 0;
  background: transparent;
  padding: 0 2px;
  color: #0a0a0a;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
  white-space: nowrap;
}

.wallet-list { margin-top: 7px; }

.empty {
  color: #999;
  font-size: 12px;
  line-height: 1.2;
  padding: 6px 0 0;
}

.wallet-row {
  border-top: 1px solid #ededed;
  padding: 8px 0;
}

.wallet-row:first-child { border-top: 0; }

.wallet-top {
  display: grid;
  grid-template-columns: 30px 26px minmax(0, 1fr) auto 28px 28px;
  align-items: center;
  column-gap: 6px;
  min-height: 34px;
}

.toggle {
  width: 28px;
  height: 17px;
  border: 0;
  border-radius: 999px;
  padding: 2px;
  background: #d5d5d5;
  cursor: pointer;
}

.toggle span {
  display: block;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #fff;
  transition: transform .15s ease;
  box-shadow: 0 1px 2px rgba(0,0,0,.15);
}

.toggle.on { background: #111; }
.toggle.on span { transform: translateX(11px); }

.index {
  font-size: 10px;
  color: #999;
  font-variant-numeric: tabular-nums;
}

.wallet-main { min-width: 0; }

.address-line {
  display: flex;
  align-items: center;
  gap: 6px;
}

.address {
  font-size: 12px;
  font-weight: 650;
}

.wallet-sub {
  font-size: 10px;
  color: #8d8d8d;
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-connect {
  height: 27px;
  border: 1px solid #d8d8d8;
  border-radius: 7px;
  padding: 0 8px;
  background: #fff;
  color: #111;
  font-size: 8px;
  line-height: 25px;
  font-weight: 750;
  letter-spacing: .035em;
  cursor: pointer;
  white-space: nowrap;
}

.row-connect.connected {
  border-color: #111;
  background: #111;
  color: #fff;
}

.icon-button {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: #888;
  cursor: pointer;
  font-size: 17px;
}

.icon-button:hover { color: #000; }

.wallet-controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin: 6px 0 0 62px;
}

.wallet-control {
  display: grid;
  grid-template-columns: auto minmax(48px, 1fr) auto auto;
  align-items: center;
  gap: 5px;
  min-width: 0;
}

.control-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .05em;
}

.control-unit {
  font-size: 9px;
  color: #888;
}

.wallet-amount,
.wallet-percent {
  height: 30px;
  min-width: 0;
  padding: 0 7px;
  border-radius: 7px;
  font-size: 12px;
  text-align: right;
}

.trade-button {
  height: 30px;
  min-width: 48px;
  border-radius: 7px;
  padding: 0 8px;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: .04em;
  cursor: pointer;
}

.trade-button.buy {
  border: 1px solid #111;
  background: #111;
  color: #fff;
}

.trade-button.sell {
  border: 1px solid #111;
  background: #fff;
  color: #111;
}

.trade-button:disabled {
  opacity: .3;
  cursor: default;
}

.order-line {
  margin: 6px 0 0 62px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  font-size: 10px;
  color: #777;
}

.order-line button,
.order-line a {
  border: 0;
  background: #fff;
  color: #111;
  text-decoration: underline;
  padding: 0;
  font-size: 10px;
  cursor: pointer;
}

.order-line button:disabled {
  color: #aaa;
  text-decoration: none;
  cursor: default;
}

.order-line.error { color: #8c2f2f; }
.order-line.success { color: #222; }

.validation {
  min-height: 14px;
  margin-top: 4px;
  font-size: 10px;
  line-height: 1.2;
  color: #888;
}

.validation.valid { color: #222; }
.validation.error { color: #8c2f2f; }

.global-settings {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.global-setting > span {
  display: block;
  margin-bottom: 5px;
  font-size: 10px;
  color: #777;
}

.global-input {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 6px;
}

.global-input input {
  height: 38px;
  text-align: right;
  font-size: 16px;
  font-weight: 650;
}

.global-input b {
  font-size: 10px;
  color: #777;
  font-weight: 500;
}

.summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 9px;
  font-size: 10px;
  color: #777;
}

.summary strong {
  color: #111;
  font-weight: 650;
}

.all-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 10px;
}

.primary {
  width: 100%;
  height: 42px;
  border-radius: 9px;
  font-size: 11px;
  font-weight: 750;
  letter-spacing: .07em;
  cursor: pointer;
}

.primary.buy-all {
  border: 1px solid #111;
  background: #111;
  color: #fff;
}

.primary.sell-all {
  border: 1px solid #111;
  background: #fff;
  color: #111;
}

.primary:disabled {
  opacity: .32;
  cursor: default;
}

.notice {
  border-top: 1px solid #e7e7e7;
  padding: 9px 0 0;
  font-size: 10px;
  line-height: 1.35;
  color: #7b2d2d;
}

.footnote {
  margin: 7px auto 0;
  max-width: 620px;
  color: #999;
  font-size: 8.5px;
  line-height: 1.25;
  text-align: center;
}

.wallet-adapter-button.wallet-connect,
.wallet-adapter-button-trigger {
  height: 34px !important;
  min-height: 34px !important;
  padding: 0 12px !important;
  border-radius: 8px !important;
  background: #fff !important;
  color: #111 !important;
  border: 1px solid #d8d8d8 !important;
  font-size: 11px !important;
  line-height: 32px !important;
  font-weight: 650 !important;
  font-family: inherit !important;
  box-shadow: none !important;
}

.wallet-adapter-button-trigger:not([disabled]):hover {
  background: #f7f7f7 !important;
}

.wallet-adapter-modal-wrapper {
  background: #fff !important;
  color: #111 !important;
}

.wallet-adapter-modal-title {
  color: #111 !important;
}

.wallet-adapter-modal-list .wallet-adapter-button {
  color: #111 !important;
}

@media (max-width: 640px) {
  .page {
    padding: 10px 12px 18px;
  }

  .topbar {
    padding-bottom: 10px;
    gap: 8px;
  }

  h1 {
    font-size: 14px;
  }

  .section {
    padding: 10px 0;
  }

  .section-head {
    margin-bottom: 7px;
    font-size: 12px;
  }

  input {
    height: 38px;
    border-radius: 8px;
    padding: 0 10px;
    font-size: 16px;
  }

  .add-row,
  .field-row {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 7px;
  }

  .text-button {
    height: 38px;
    font-size: 11px;
  }

  .wallet-list {
    margin-top: 4px;
  }

  .empty {
    padding: 4px 0 0;
    font-size: 11px;
  }

  .wallet-row {
    padding: 7px 0;
  }

  .wallet-top {
    grid-template-columns:
      28px 22px minmax(0, 1fr)
      auto 24px 24px;
    column-gap: 4px;
  }

  .address {
    font-size: 11px;
  }

  .wallet-sub {
    font-size: 9px;
  }

  .row-connect {
    height: 25px;
    padding: 0 6px;
    border-radius: 6px;
    font-size: 7px;
    line-height: 23px;
  }

  .wallet-controls {
    margin-left: 54px;
    gap: 6px;
  }

  .wallet-control {
    grid-template-columns:
      auto minmax(38px, 1fr) auto auto;
    gap: 4px;
  }

  .control-label {
    font-size: 8px;
  }

  .control-unit {
    font-size: 8px;
  }

  .wallet-amount,
  .wallet-percent {
    height: 28px;
    padding: 0 5px;
    font-size: 11px;
  }

  .trade-button {
    height: 28px;
    min-width: 43px;
    padding: 0 6px;
    font-size: 8px;
  }

  .order-line {
    margin-left: 54px;
    font-size: 9px;
  }

  .global-settings {
    gap: 8px;
  }

  .global-setting > span {
    margin-bottom: 4px;
    font-size: 9px;
  }

  .global-input input {
    height: 36px;
    font-size: 15px;
  }

  .summary {
    margin-top: 7px;
    font-size: 9.5px;
  }

  .all-actions {
    gap: 7px;
    margin-top: 8px;
  }

  .primary {
    height: 40px;
    font-size: 10px;
  }

  .wallet-adapter-button.wallet-connect,
  .wallet-adapter-button-trigger {
    max-width: 132px;
    height: 32px !important;
    min-height: 32px !important;
    padding: 0 10px !important;
    font-size: 10px !important;
    line-height: 30px !important;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}
